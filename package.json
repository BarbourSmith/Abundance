{
  "homepage": "https://abundance.maslowcnc.com",
  "name": "replicad-app-example",
  "version": "0.14.6",
  "description": "A simple React app based on replicad.",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-types": "cp node_modules/replicad/dist/replicad.d.ts public/replicad.d.ts",
    "build:ts-framework": "node scripts/build-ts-framework.mjs",
    "start": "npm run copy-types && vite",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build": "npm run copy-types && npm run build:ts-framework && vite build && cp ./dist/index.html ./dist/404.html",
    "serve": "vite preview",
    "test": "node Puppet/index.js",
    "test:metrics": "node Puppet/metrics.js",
    "coverage": "vitest run --coverage",
    "unit": "vitest run --config=vitest.browser.config.ts",
    "lint": "eslint src/**/*.ts src/**/*.tsx"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/material": "^7.1.1",
    "@octokit/core": "^6.1.2",
    "@octokit/plugin-paginate-rest": "^11.3.5",
    "@octokit/rest": "^21.0.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.15.16",
    "@vitest/coverage-v8": "^3.2.4",
    "circular-menu": "^1.0.6",
    "comlink": "^4.4.1",
    "eslint-linter-browserify": "^9.17.0",
    "file-saver": "^2.0.5",
    "geometry-utils": "file:vendor/geometry-utils",
    "wasm-nesting": "file:vendor/wasm-nesting",
    "js-sha256": "^0.11.1",
    "mathjs": "^12.4.3",
    "oauthio-web": "^0.6.2",
    "octokit": "^5.0.4",
    "pako": "^2.1.0",
    "playwright": "^1.56.0",
    "polygon-packer": "file:vendor/polygon-packer",
    "puppeteer": "^24.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-is": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.22.3",
    "react-select": "^5.8.0",
    "rehype-raw": "^7.0.0",
    "replicad": "^0.22.0",
    "replicad-decorate": "^0.1.2",
    "replicad-opencascadejs": "^0.20.2",
    "replicad-shrink-wrap": "^0.1.0",
    "replicad-threejs-helper": "^0.20.0",
    "save-dev": "^0.0.1-security",
    "showdown": "^2.1.0",
    "three": "^0.161.0",
    "url": "^0.11.4",
    "uuid": "^9.0.1",
    "vitest-browser-react": "^1.0.1",
    "workerpool": "^9.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "4.2.1",
    "@vitest/browser": "^3.2.4",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.2",
    "gh-pages": "^6.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^5.1.6",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-pages": "^0.32.3",
    "vitest": "^3.2.4"
  },
  "browserslist": [
    ">0.2%",
    "not dead"
  ]
}
